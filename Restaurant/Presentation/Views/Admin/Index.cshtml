@{
    ViewData["Title"] = "Адмін-панель";
}

<div class="page-title">
    <div class="container">
        <h1>Адмін-панель</h1>
        <span class="text-muted">Управління залами та столиками · Role = Admin</span>
    </div>
</div>

<div class="container">

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3" id="adminTabs">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#halls">Зали</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#tables">Столики</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#reservations">Всі бронювання</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#users">Користувачі</a>
        </li>
    </ul>

    <div class="tab-content">

        <!-- ===== HALLS ===== -->
        <div class="tab-pane fade show active" id="halls">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0">Зали <span class="text-muted fw-normal small">GET /api/halls</span></h6>
                <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalAddHall">
                    + Додати зал
                </button>
            </div>
            <div class="card">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Назва</th>
                                <th>Ширина (W)</th>
                                <th>Довжина (L)</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-semibold">Зал А</td>
                                <td>10</td>
                                <td>12</td>
                                <td>
                                    <button class="btn btn-outline-secondary btn-sm">Ред.</button>
                                    <button class="btn btn-outline-danger btn-sm ms-1">Вид.</button>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">Зал Б</td>
                                <td>8</td>
                                <td>10</td>
                                <td>
                                    <button class="btn btn-outline-secondary btn-sm">Ред.</button>
                                    <button class="btn btn-outline-danger btn-sm ms-1">Вид.</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ===== TABLES ===== -->
        <div class="tab-pane fade" id="tables">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0">Столики <span class="text-muted fw-normal small">GET /api/tables</span></h6>
                <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalAddTable">
                    + Додати столик
                </button>
            </div>
            <div class="card">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>№</th>
                                <th>Зал</th>
                                <th>Місткість</th>
                                <th>WidthPos</th>
                                <th>LengthPos</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td><td>Зал А</td><td>4</td><td>2</td><td>3</td>
                                <td>
                                    <button class="btn btn-outline-secondary btn-sm">Ред.</button>
                                    <button class="btn btn-outline-danger btn-sm ms-1">Вид.</button>
                                </td>
                            </tr>
                            <tr>
                                <td>2</td><td>Зал А</td><td>2</td><td>4</td><td>1</td>
                                <td>
                                    <button class="btn btn-outline-secondary btn-sm">Ред.</button>
                                    <button class="btn btn-outline-danger btn-sm ms-1">Вид.</button>
                                </td>
                            </tr>
                            <tr>
                                <td>3</td><td>Зал Б</td><td>6</td><td>1</td><td>2</td>
                                <td>
                                    <button class="btn btn-outline-secondary btn-sm">Ред.</button>
                                    <button class="btn btn-outline-danger btn-sm ms-1">Вид.</button>
                                </td>
                            </tr>
                            <tr>
                                <td>4</td><td>Зал Б</td><td>4</td><td>3</td><td>4</td>
                                <td>
                                    <button class="btn btn-outline-secondary btn-sm">Ред.</button>
                                    <button class="btn btn-outline-danger btn-sm ms-1">Вид.</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ===== RESERVATIONS ===== -->
        <div class="tab-pane fade" id="reservations">
            <h6 class="fw-bold mb-2">Всі бронювання <span class="text-muted fw-normal small">GET /api/reservations</span></h6>
            <div class="card">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Користувач</th>
                                <th>Столики</th>
                                <th>Початок</th>
                                <th>Кінець</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-muted small">a1b2…</td>
                                <td>user123</td>
                                <td>№1, №3</td>
                                <td>05.04.2026 19:00</td>
                                <td>05.04.2026 21:00</td>
                                <td>
                                    <button class="btn btn-outline-danger btn-sm">Вид.</button>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted small">c3d4…</td>
                                <td>john_doe</td>
                                <td>№2</td>
                                <td>10.04.2026 20:00</td>
                                <td>10.04.2026 22:00</td>
                                <td>
                                    <button class="btn btn-outline-danger btn-sm">Вид.</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ===== USERS ===== -->
        <div class="tab-pane fade" id="users">
            <h6 class="fw-bold mb-2">Користувачі <span class="text-muted fw-normal small">GET /api/users</span></h6>
            <div class="card">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Login</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>admin</td>
                                <td>admin@restaurant.com</td>
                                <td><span class="badge bg-danger">Admin</span></td>
                                <td>
                                    <button class="btn btn-outline-danger btn-sm">Вид.</button>
                                </td>
                            </tr>
                            <tr>
                                <td>user123</td>
                                <td>user@example.com</td>
                                <td><span class="badge bg-secondary">User</span></td>
                                <td>
                                    <button class="btn btn-outline-danger btn-sm">Вид.</button>
                                </td>
                            </tr>
                            <tr>
                                <td>john_doe</td>
                                <td>john@example.com</td>
                                <td><span class="badge bg-secondary">User</span></td>
                                <td>
                                    <button class="btn btn-outline-danger btn-sm">Вид.</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Modal: Add Hall -->
<div class="modal fade" id="modalAddHall" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Додати зал <span class="text-muted fw-normal small">POST /api/halls</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" name="Name" placeholder="Назва залу" />
                    </div>
                    <div class="row g-3">
                        <div class="col">
                            <label class="form-label">Width</label>
                            <input type="number" class="form-control" name="Width" min="1" />
                        </div>
                        <div class="col">
                            <label class="form-label">Length</label>
                            <input type="number" class="form-control" name="Length" min="1" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Скасувати</button>
                    <button type="submit" class="btn btn-primary">Зберегти</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Add Table -->
<div class="modal fade" id="modalAddTable" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Додати столик <span class="text-muted fw-normal small">POST /api/tables</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">HallId</label>
                        <select class="form-select" name="HallId">
                            <option value="guid-hall-a">Зал А</option>
                            <option value="guid-hall-b">Зал Б</option>
                        </select>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col">
                            <label class="form-label">Number</label>
                            <input type="number" class="form-control" name="Number" min="1" />
                        </div>
                        <div class="col">
                            <label class="form-label">Capacity</label>
                            <input type="number" class="form-control" name="Capacity" min="1" />
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col">
                            <label class="form-label">WidthPosition</label>
                            <input type="number" class="form-control" name="WidthPosition" min="0" />
                        </div>
                        <div class="col">
                            <label class="form-label">LengthPosition</label>
                            <input type="number" class="form-control" name="LengthPosition" min="0" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Скасувати</button>
                    <button type="submit" class="btn btn-primary">Зберегти</button>
                </div>
            </form>
        </div>
    </div>
</div>
