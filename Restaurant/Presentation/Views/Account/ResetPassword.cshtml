@model Restaurant.Presentation.ViewModels.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Скидання пароля";
}

<div class="container mt-4" style="max-width: 500px;">
    <h3>Скидання пароля</h3>

    @if (ViewBag.SuccessMessage is not null)
    {
        <div class="alert alert-success">@ViewBag.SuccessMessage</div>
    }

    <form asp-action="ResetPassword" method="post">
        <input asp-for="Email" type="hidden" />
        <input asp-for="Token" type="hidden" />

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <button type="submit" class="btn btn-primary">Оновити пароль</button>
    </form>
</div>
