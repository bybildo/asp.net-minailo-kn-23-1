@{
    ViewData["Title"] = "Реєстрація";
}

<div class="auth-box">
    <div class="auth-card">
        <h4>Реєстрація</h4>
        <p class="text-muted small mb-4">POST /api/users/auth</p>

        <form id="register-form" method="post">
            <div class="mb-3">
                <label class="form-label" for="login">Логін</label>
                <input type="text" id="login" name="Login" class="form-control" placeholder="your_login" autocomplete="username" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="email">Email</label>
                <input type="email" id="email" name="Email" class="form-control" placeholder="your@email.com" autocomplete="email" />
            </div>
            <div class="mb-4">
                <label class="form-label" for="password">Пароль</label>
                <input type="password" id="password" name="Password" class="form-control" placeholder="••••••••" autocomplete="new-password" />
            </div>
            <div id="errorMsg" class="text-danger small" style="display:none;"></div>
            <button type="submit" class="btn btn-primary w-100">Зареєструватись</button>
        </form>

        <hr />
        <p class="text-center small mb-0">
            Вже є акаунт?
            <a asp-controller="Account" asp-action="Login">Увійти</a>
        </p>
    </div>
</div>
