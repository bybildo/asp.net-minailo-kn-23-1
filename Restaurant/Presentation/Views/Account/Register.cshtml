@model Restaurant.Presentation.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Реєстрація";
}

<div class="auth-box">
    <div class="auth-card">
        <h4>Реєстрація</h4>
        <p class="text-muted small mb-4">Реєстрація через MVC</p>

        <form asp-controller="Account" asp-action="Register" method="post">
            <div class="mb-3">
                <label class="form-label" for="fullName">Ім'я</label>
                <input asp-for="FullName" id="fullName" class="form-control" placeholder="Ваше ім'я" autocomplete="name" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="email">Email</label>
                <input asp-for="Email" id="email" class="form-control" placeholder="your@email.com" autocomplete="email" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">Пароль</label>
                <input asp-for="Password" id="password" class="form-control" placeholder="••••••••" autocomplete="new-password" />
            </div>
            <div class="mb-4">
                <label class="form-label" for="confirmPassword">Підтвердження пароля</label>
                <input asp-for="ConfirmPassword" id="confirmPassword" class="form-control" placeholder="••••••••" autocomplete="new-password" />
            </div>
            <div asp-validation-summary="All" class="text-danger small"></div>
            <button type="submit" class="btn btn-primary w-100">Зареєструватись</button>
        </form>

        <hr />
        <p class="text-center small mb-0">
            Вже є акаунт?
            <a asp-controller="Account" asp-action="Login">Увійти</a>
        </p>
    </div>
</div>


