@model Restaurant.Presentation.ViewModels.Tables.TablesIndexViewModel
@{
    ViewData["Title"] = "Столики";
}

@section Styles {
    <style>
        .hall-map-wrap {
            overflow-x: auto;
            padding: 1rem;
            background: #f9f9f9;
            border: 1px solid #dee2e6;
            border-radius: 6px;
        }

        .hall-grid {
            display: inline-grid;
            gap: 8px;
        }

        .hall-cell {
            width: 72px;
            height: 72px;
            border-radius: 6px;
            border: 2px dashed #dee2e6;
            background: #fff;
        }

        .table-cell {
            width: 72px;
            height: 72px;
            border-radius: 6px;
            border: 2px solid;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: .8rem;
            font-weight: 600;
            transition: transform .1s, box-shadow .1s;
            user-select: none;
        }

            .table-cell:hover {
                transform: scale(1.06);
                box-shadow: 0 3px 10px rgba(0,0,0,.15);
            }

        .table-free {
            background: #d4edda;
            border-color: #28a745;
            color: #155724;
        }

        .table-busy {
            background: #f8d7da;
            border-color: #dc3545;
            color: #721c24;
            cursor: not-allowed;
        }

            .table-busy:hover {
                transform: none;
                box-shadow: none;
            }

        .table-selected {
            background: #cce5ff;
            border-color: #004085;
            color: #004085;
            outline: 3px solid #004085;
            outline-offset: 2px;
        }

        .table-cell .t-num {
            font-size: 1rem;
            line-height: 1;
        }

        .table-cell .t-cap {
            font-size: .7rem;
            opacity: .8;
        }

        .hall-btn.active {
            background: #7B1E1E;
            color: #fff;
            border-color: #7B1E1E;
        }

        .legend-dot {
            display: inline-block;
            width: 12px;
            height: 12px;
            border-radius: 3px;
            border: 2px solid;
            margin-right: 4px;
            vertical-align: middle;
        }
    </style>
}

<div class="page-title">
    <div class="container">
        <h1>Карта залів</h1>
        <span class="text-muted small">Оберіть зал, час — і побачите доступні столики</span>
    </div>
</div>

<div class="container pb-4">
    <div class="row g-3">

        <!-- ===== ЛІВА ПАНЕЛЬ ===== -->
        <div class="col-lg-3">

            <!-- Список залів -->
            <div class="card mb-3">
                <div class="card-header">Зали</div>
                <div class="list-group list-group-flush" id="hallList">
                    <!-- генерується JS -->
                </div>
            </div>

            <!-- Обрані столики -->
            <div class="card" id="selectionCard" style="display:none;">
                <div class="card-header">Обрані столики</div>
                <div class="card-body">
                    <div id="selectionInfo" class="mb-3"></div>
                    <a id="bookBtn" class="btn btn-primary btn-sm w-100" href="#">
                        Забронювати →
                    </a>
                </div>
            </div>

            <!-- Легенда -->
            <div class="mt-3 small text-muted">
                <div><span class="legend-dot" style="background:#d4edda;border-color:#28a745;"></span> Вільний</div>
                <div class="mt-1"><span class="legend-dot" style="background:#f8d7da;border-color:#dc3545;"></span> Зайнятий / заброньований</div>
                <div class="mt-1"><span class="legend-dot" style="background:#cce5ff;border-color:#004085;"></span> Обраний</div>
                <div class="mt-1"><span class="legend-dot" style="background:#fff;border-color:#dee2e6;"></span> Вільна клітинка</div>
            </div>
        </div>

        <!-- ===== ПРАВА ПАНЕЛЬ ===== -->
        <div class="col-lg-9">

            <!-- Вибір часу -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row g-2 align-items-end">
                        <div class="col-auto">
                            <label class="form-label small mb-1">Початок <span class="text-muted">(StartDate)</span></label>
                            <input type="datetime-local" id="startDate" class="form-control form-control-sm"
                                   value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-ddTHH:00")" />
                        </div>
                        <div class="col-auto">
                            <label class="form-label small mb-1">Тривалість</label>
                            <select id="duration" class="form-select form-select-sm">
                                <option value="1">1 година</option>
                                <option value="2" selected>2 години</option>
                                <option value="3">3 години</option>
                                <option value="4">4 години</option>
                                <option value="5">6 годин</option>
                                <option value="end">До кінця дня</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Карта зали -->
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span id="hallTitle">Оберіть зал зліва</span>
                        <span id="hallDims" class="text-muted small"></span>
                    </div>
                    <div class="card-body">
                        <div id="mapPlaceholder" class="text-center text-muted py-5">
                            ← Оберіть зал зі списку
                        </div>
                        <div class="hall-map-wrap" id="mapWrap" style="display:none;">
                            <div class="hall-grid" id="hallGrid"></div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

@section Scripts {
        <script>
            let user = null;
            const modelUserId = '@(Model.UserId?.ToString() ?? "")';
            const rawHalls = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Halls));
            const rawTables = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tables));
            const rawReservations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Reservations));

            const modelHalls = (rawHalls ?? []).map(h => ({
                id: h.id ?? h.Id,
                name: h.name ?? h.Name,
                width: h.width ?? h.Width,
                length: h.length ?? h.Length
            }));

            const modelTables = (rawTables ?? []).map(t => ({
                id: t.id ?? t.Id,
                hallId: t.hallId ?? t.HallId,
                number: t.number ?? t.Number,
                capacity: t.capacity ?? t.Capacity,
                widthPosition: t.widthPosition ?? t.WidthPosition,
                lengthPosition: t.lengthPosition ?? t.LengthPosition
            }));

            const modelReservations = (rawReservations ?? []).map(r => ({
                tablesIds: r.tablesIds ?? r.TablesIds ?? [],
                startDate: r.startDate ?? r.StartDate,
                endDate: r.endDate ?? r.EndDate
            }));

            function loadUserId(){
                if (modelUserId) {
                    user = modelUserId;
                    return;
                }
                document.getElementById('bookBtn').textContent = 'Увійдіть, щоб забронювати';
                document.getElementById('bookBtn').href = '/Account/Login';
            }

            const halls = [];

            function loadHalls() {
                halls.push(...modelHalls);
            }

            const tables = [];

            function loadTables(hallId) {
                tables.length = 0;
                tables.push(...modelTables.filter(t => t.hallId === hallId));
            }

            const reservations = [];

            function loadReservations(hallId) {
                const data = modelReservations.filter(r => {
                    const reservationTableIds = r.tablesIds ?? [];
                    return reservationTableIds.some(id => modelTables.some(t => t.id === id && t.hallId === hallId));
                });
                reservations.length = 0;
                data.forEach(r => {
                    reservations.push({
                        tableIds:  r.tablesIds,
                        startDate: new Date(r.startDate),
                        endDate:   new Date(r.endDate)
                    });
                });
            }

            // ─── Стан ────────────────────────────────────────────────────────────────
            let currentHallId = null;
            let busyTableIds   = new Set(); // перевірені як зайняті
            let checkedOnce    = false;
            let selectedTableIds = [];

            // ─── Ініціалізація ────────────────────────────────────────────────────────
            async function init() {
                const list = document.getElementById('hallList');
                halls.forEach(hall => {
                    const a = document.createElement('a');
                    a.href = '#';
                    a.className = 'list-group-item list-group-item-action d-flex justify-content-between hall-btn';
                    a.dataset.id = hall.id;
                    a.innerHTML = `
                        <span>${hall.name}</span>
                        <span class="text-muted small">${hall.width}×${hall.length}</span>
                    `;
                    a.addEventListener('click', async e => { e.preventDefault(); await selectHall(hall.id); });
                    list.appendChild(a);
                });
            }

            // ─── Вибір залу ──────────────────────────────────────────────────────────
            async function selectHall(hallId) {
                currentHallId = hallId;
                selectedTableIds = [];

                loadTables(hallId);
                loadReservations(hallId);

                checkedOnce = true;
                checkAvailability(); 
            
                document.getElementById('selectionCard').style.display = 'none';

                document.querySelectorAll('.hall-btn').forEach(b => {
                    b.classList.toggle('active', b.dataset.id === hallId);
                });

                const hall = halls.find(h => h.id === hallId);
                document.getElementById('hallTitle').textContent = hall.name;
                document.getElementById('hallDims').textContent = `матриця ${hall.width} × ${hall.length}`;
                document.getElementById('mapPlaceholder').style.display = 'none';
                document.getElementById('mapWrap').style.display = '';

                renderMap(hall);
            }

            // ─── Рендер карти ────────────────────────────────────────────────────────
            function renderMap(hall) {
                const grid = document.getElementById('hallGrid');
                grid.innerHTML = '';
                grid.style.gridTemplateColumns = `repeat(${hall.width}, 72px)`;
                grid.style.gridTemplateRows    = `repeat(${hall.length}, 72px)`;

                const hallTables = tables.filter(t => t.hallId === hall.id);

                // lookup позиція → столик
                const posMap = {};
                hallTables.forEach(t => { posMap[`${t.widthPosition},${t.lengthPosition}`] = t; });

                for (let row = 1; row <= hall.length; row++) {
                    for (let col = 1; col <= hall.width; col++) {
                        const t = posMap[`${col},${row}`];
                        const cell = document.createElement('div');
                        cell.style.gridColumn = col;
                        cell.style.gridRow    = row;

                        if (!t) {
                            cell.className = 'hall-cell';
                        } else {
                            const isBusy     = checkedOnce && busyTableIds.has(t.id);
                            const isSelected = selectedTableIds.includes(t.id);
                            cell.className = 'table-cell ' +
                                (isSelected ? 'table-selected' : isBusy ? 'table-busy' : 'table-free');
                            cell.dataset.id = t.id;
                            cell.innerHTML = `<div class="t-num">№${t.number}</div><div class="t-cap">👥 ${t.capacity}</div>`;
                            if (!isBusy) cell.addEventListener('click', () => selectTable(t.id));
                        }
                        grid.appendChild(cell);
                    }
                }
            }

            // ─── Перевірка доступності ───────────────────────────────────────────────
            function checkAvailability() {
                const start = new Date(document.getElementById('startDate').value);
                const end = calcEndDate();

                if (!start || !end || start >= end) return;

                busyTableIds.clear();
                reservations.forEach(r => {
                    if (start < r.endDate && end > r.startDate) {
                       if (r.tableIds && Array.isArray(r.tableIds)) {
                            r.tableIds.forEach(id => busyTableIds.add(id));
                       }
                    }
                });

                checkedOnce = true; 
                selectedTableIds = [];

                document.getElementById('selectionCard').style.display = 'none';

                if (currentHallId) {
                    const hall = halls.find(h => h.id === currentHallId);
                    renderMap(hall);
                }
            }

            function calcEndDate() {
                const startVal = document.getElementById('startDate').value;
                if (!startVal) return null;

                const start = new Date(startVal);
                const duration = document.getElementById('duration').value;

                let end;
                if (duration === 'end') {
                    end = new Date(start);
                    end.setHours(23, 59, 0, 0);
                } else {
                    end = new Date(start.getTime() + parseInt(duration) * 60 * 60 * 1000);
                }

                return end;
            }

            document.getElementById('startDate').addEventListener('change', checkAvailability);
            document.getElementById('duration').addEventListener('change', checkAvailability);

            // ─── Вибір столика ───────────────────────────────────────────────────────
            function selectTable(tableId) {
                if (selectedTableIds.includes(tableId)) {
                    selectedTableIds = selectedTableIds.filter(id => id !== tableId);
                } else {
                    selectedTableIds.push(tableId);
                }


                if (selectedTableIds.length > 0) {
                    document.getElementById('selectionCard').style.display = '';
                    const selectedTables = tables.filter(t => selectedTableIds.includes(t.id));
                    const totalCapacity = selectedTables.reduce((sum, t) => sum + t.capacity, 0);
                    const tableNumbers = selectedTables.map(t => '№' + t.number).join(', ');
                    const hall = halls.find(h => h.id === selectedTables[0].hallId);
                    const startVal = document.getElementById('startDate').value;
                    const end = calcEndDate();
                    const startStr = startVal ? new Date(startVal).toLocaleString('uk', { hour:'2-digit', minute:'2-digit', day:'2-digit', month:'2-digit' }) : '—';
                    const endStr   = end      ? end.toLocaleString('uk', { hour:'2-digit', minute:'2-digit' }) : '—';

                    document.getElementById('selectionInfo').innerHTML = `
                        <div class="small">
                            <div><strong>Зал:</strong> ${hall?.name ?? '—'}</div>
                            <div><strong>Столики:</strong> ${tableNumbers}</div>
                            <div><strong>Місткість:</strong> ${totalCapacity} осіб</div>
                            <div><strong>Час:</strong> ${startStr} - ${endStr}</div>
                        </div>`;

                } else {
                    document.getElementById('selectionCard').style.display = 'none';
                }

                const hall = halls.find(h => h.id === currentHallId);
                renderMap(hall);
            }

            document.getElementById('bookBtn').addEventListener('click', (e) => {
                e.preventDefault();
                if (user === null) {
                    return;
                }

                if (selectedTableIds.length === 0) {
                    alert('Оберіть столик');
                    return;
                }

                const startVal = document.getElementById('startDate').value;
                const end = calcEndDate();

                if (!startVal || !end) {
                    alert('Вкажіть час');
                    return;
                }

                const pad = (n) => String(n).padStart(2, '0');
                const toLocalStr = (d) => `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;

                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Tables/Book';
                form.style.display = 'none';

                const appendInput = (name, value) => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = name;
                    input.value = value;
                    form.appendChild(input);
                };

                selectedTableIds.forEach(id => appendInput('tableIds', id));
                appendInput('startDate', startVal);
                appendInput('endDate', toLocalStr(end));
                document.body.appendChild(form);
                form.submit();
            });

            async function start() {
                loadUserId();
                loadHalls();
                await init();
            }

            start();
        </script>
}
