@model Restaurant.Presentation.ViewModels.Reservations.ReservationsIndexViewModel
@{
    ViewData["Title"] = "Мої бронювання";
}

<div class="page-title">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h1>Мої бронювання</h1>
            <span class="text-muted">Список ваших бронювань</span>
        </div>
        <a asp-controller="Tables" asp-action="Index" class="btn btn-primary btn-sm">
            + Нове бронювання
        </a>
    </div>
</div>

<div class="container">
    <div id="reservations" class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Зал</th>
                        <th>Столики</th>
                        <th>Початок</th>
                        <th>Кінець</th>
                        <th>Статус</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tbody">
                    @if (!Model.Reservations.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-3">Немає бронювань</td></tr>
                    }
                    else
                    {
                        @foreach (var r in Model.Reservations)
                        {
                            var badgeClass = r.Status == "Активне" ? "badge-free"
                                : r.Status == "Очікує" ? "badge-reserved"
                                : "badge-done";
                            <tr>
                                <td>@r.HallName</td>
                                <td>@string.Join(", ", r.TablesNumbers)</td>
                                <td>@r.StartDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@r.EndDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td><span class="@badgeClass">@r.Status</span></td>
                                <td>
                                    <form asp-controller="Reservations" asp-action="Delete" method="post">
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button id="deleteButton" type="submit">Видалити Бронь</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <p id="message" class="text-muted small mt-2">
        Видалення виконується через MVC форму
    </p>
</div>