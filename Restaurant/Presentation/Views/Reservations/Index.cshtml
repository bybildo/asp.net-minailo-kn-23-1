@{
    ViewData["Title"] = "Мої бронювання";
}

<div class="page-title">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h1>Мої бронювання</h1>
            <span class="text-muted">GET /api/reservations</span>
        </div>
        <a asp-controller="Tables" asp-action="Index" class="btn btn-primary btn-sm">
            + Нове бронювання
        </a>
    </div>
</div>

<div class="container">
    <div id="reservations" class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Зал</th>
                        <th>Столики</th>
                        <th>Початок</th>
                        <th>Кінець</th>
                        <th>Статус</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tbody">
                </tbody>
            </table>
        </div>
    </div>

    <p id="message" class="text-muted small mt-2">
        Бронювання видаляється через DELETE /api/reservations/{id}
    </p>
</div>

<script>
        async function deleteReservation(id) {
            const response = await fetch(`/api/reservations/${id}`, {
                method: 'DELETE'
            });
            if (response.ok) {
                loadReservations();
            } else {
                alert('Помилка видалення бронювання');
            }
        }

        async function loadReservations() {
        const response = await fetch('/api/reservations');

        if (!response.ok) {
            document.getElementById('message').innerText = 'Помилка завантаження';
            document.getElementById('reservations').style.display = 'none';
            return;
        }

        const text = await response.text();
        if (!text) {
            document.getElementById('message').innerText = 'Немає бронювань';
            document.getElementById('reservations').style.display = 'none';
            return;
        }

        const data = JSON.parse(text);

        if (!data || data.length === 0) {
            document.getElementById('message').innerText = 'Немає бронювань';
            document.getElementById('reservations').style.display = 'none';
            return;
        }

        const tbody = document.getElementById('tbody');

        function getDate(date){
            const d = new Date(date);
            const dateStr = d.toLocaleDateString('uk');
            const timeStr = d.toLocaleTimeString('uk', { hour: '2-digit', minute: '2-digit' });
            return `${dateStr} ${timeStr}`
        }

        tbody.innerHTML = '';
        data.forEach(r => {
            const tr = document.createElement('tr');
            const badgeClass = r.status === 'Активне' ? 'badge-free'
                     : r.status === 'Очікує'  ? 'badge-reserved'
                     : 'badge-done';
            tr.innerHTML = `
                <td>${r.hallName}</td>
                <td>${(r.tablesNumbers ?? []).join(', ')}</td>
                <td>${getDate(r.startDate)}</td>
            <td>${getDate(r.endDate)}</td>
                <td><span class="${badgeClass}">${r.status}</span></td>
                <td>
                <button id="deleteButton" onclick="deleteReservation('${r.id}')">Видалити Бронь</button>
                </td>
            `;

            tbody.appendChild(tr);
        });
        };

        loadReservations();
</script>