<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Restaurant</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav class="site-nav">
        <div class="container d-flex align-items-center gap-3">
            <a class="brand me-3" asp-controller="Home" asp-action="Index">🍽 Restaurant</a>

            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tables" ? "active" : "")"
               asp-controller="Tables" asp-action="Index">Столики</a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservations" ? "active" : "")"
                   asp-controller="Reservations" asp-action="Index">Мої бронювання</a>
            }

            @if (User.IsInRole("Admin"))
            {
                <a class="nav-link" asp-controller="Admin" asp-action="Index">Адмін</a>
            }

            <div class="ms-auto d-flex gap-2 align-items-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span style="color:#fff; font-weight:600;">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Вийти</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Увійти</a>
                    <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Register">Реєстрація</a>
                }
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer>
        &copy; @DateTime.Now.Year Restaurant — бронювання столиків
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>