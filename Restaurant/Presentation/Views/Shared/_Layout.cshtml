<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Restaurant</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav class="site-nav">
        <div class="container d-flex align-items-center gap-3">
            <a class="brand me-3" asp-controller="Home" asp-action="Index">🍽 Restaurant</a>

            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tables" ? "active" : "")"
               asp-controller="Tables" asp-action="Index">Столики</a>

            <a style="display:none;" id="nav-reservations" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservations" ? "active" : "")"
               asp-controller="Reservations" asp-action="Index">Мої бронювання</a>

            <a id="nav-admin" style="display:none;"
               class="nav-link"
               asp-controller="Admin" asp-action="Index">Адмін</a>

            <div class="ms-auto d-flex gap-2 align-items-center">
                <a id="nav-login" class="btn btn-sm btn-outline-light"
                   asp-controller="Account" asp-action="Login">Увійти</a>
                <a id="nav-register" class="btn btn-sm btn-primary"
                   asp-controller="Account" asp-action="Register">Реєстрація</a>

                <span id="nav-username" style="display:none; color:#fff; font-weight:600;"></span>
                <button id="nav-logout" style="display:none; color:orangered;"
                        class="btn btn-sm btn-outline-danger">
                    Вийти
                </button>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer>
        &copy; @DateTime.Now.Year Restaurant — бронювання столиків &nbsp;|&nbsp;
        <a href="/swagger" style="color:var(--accent);">API</a>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<script>
    document.getElementById('nav-logout').addEventListener('click', async () => {
        const response = await fetch('/api/users/logout', {
            method: 'GET'
        });
        if (response.ok) {
            document.getElementById('nav-login').style.display = 'inline';
            document.getElementById('nav-register').style.display = 'inline';
            document.getElementById('nav-username').style.display = 'none';
            document.getElementById('nav-logout').style.display = 'none';
            document.getElementById('nav-admin').style.display = 'none';
            document.getElementById('nav-reservations').style.display = 'none';
            window.location.href = '/';
        }

    });

    async function checkAuth() {
        const response = await fetch('/api/users/verify', {
            method: 'GET'
        });
        if (response.ok) {
            const user = await response.json();

            document.getElementById('nav-login').style.display = 'none';
            document.getElementById('nav-register').style.display = 'none';
            document.getElementById('nav-username').style.display = 'inline';
            document.getElementById('nav-reservations').style.display = 'inline';
            document.getElementById('nav-username').textContent = user.login;
            document.getElementById('nav-logout').style.display = 'inline';

            if (user.role === 'Admin') {
                document.getElementById('nav-admin').style.display = 'inline';
            }
        }
    }
    checkAuth();
</script>